# ── LLM ──────────────────────────────────────────────────────────────────────
# Groq API — Llama 3.1 8B Instant (free tier: 14,400 req/day)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── YouTube ───────────────────────────────────────────────────────────────────
# YouTube Data API v3 — free quota: 10,000 units/day
# Get it at: https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# ── Instagram ─────────────────────────────────────────────────────────────────
# Supadata API — 100 free requests/month, no credit card
# Sign up at: https://supadata.ai
SUPADATA_API_KEY=your_supadata_api_key_here

# ── Storage ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
HF_HOME=./hf_cache
